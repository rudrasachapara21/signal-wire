# Signal Wire Frontend — Environment Variables
# Copy this file to .env and fill in real values.
# IMPORTANT: Only VITE_-prefixed variables are exposed to the browser bundle.
# Never put raw API keys, database credentials, or secrets here without reviewing this.

# ─── API base URL ─────────────────────────────────────────────────────────────
# The base URL for the Signal Wire backend API.
# Used by client-side fetch calls to reach backend endpoints (auth, strategy generation, etc.)
# TODO: Set this to your deployed backend URL (e.g. https://api.signal-wire.app) or local dev URL
VITE_API_BASE_URL=http://localhost:8000

# ─── NOT included — server-side only secrets ─────────────────────────────────
# The following from the backend .env.example are server-side only and must NOT
# be added here (they don't need VITE_ prefix and would expose secrets in the bundle):
#   GEMINI_API_KEY  — backend AI inference only, never client-exposed
#   TAVILY_API_KEY  — backend web search only, never client-exposed
