# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# Gemini API — https://aistudio.google.com/
# Used as the FINAL fallback in the LLM chain (Groq → OpenRouter → Gemini)
GEMINI_API_KEY=your_gemini_key_here

# Tavily API — https://tavily.com/
# Used by the legacy /api/generate-report endpoint only
TAVILY_API_KEY=your_tavily_key_here

# Groq API — https://console.groq.com/
# PRIMARY provider for /api/analyze-brand. Free tier: ~30 RPM, very generous.
# Model: llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_key_here

# OpenRouter API — https://openrouter.ai/
# SECONDARY provider (fallback if Groq is rate-limited). Free tier available.
# Model: nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=your_openrouter_key_here

# JWT Secret — used to sign session cookies for auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate-a-real-random-secret-here
